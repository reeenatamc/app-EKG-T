# Plantilla de configuracion local. Copiar a .env y ajustar los valores.
#
#   cp .env.example .env
#
# .env NO se versiona. Este archivo si, para que quede documentado que
# variables necesita el proyecto.

# URL base del backend de Python que ejecuta los modelos de digitalizacion
# e interpretacion. Sin barra final.
#
# Emulador Android: usar 10.0.2.2 en lugar de localhost.
# Dispositivo fisico: usar la IP de la maquina en la red local.
API_BASE_URL=http://localhost:8000
