{
  "name": "app-ekg",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "//overrides": "react-dom llega como peer transitivo de la cadena de expo-router y solo se usa en web, plataforma que este proyecto no compila. Su ultima version exige react ^19.2.8 y romperia el react 19.2.3 que fija Expo SDK 57. Se alinea con react en lugar de instalar con --legacy-peer-deps, que ocultaria el conflicto en vez de resolverlo.",
  "overrides": {
    "react-dom": "19.2.3"
  },
